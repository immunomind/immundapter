Package: immundapter
Type: Package
Title: Lightweight R Adapters for External Immune Repertoire Tools
Version: 0.1.0
Depends:
    R (>= 4.1.0)
Authors@R:
    person("Vadim I.", "Nazarov", , "support@immunomind.com", role = c("aut", "cre"),
